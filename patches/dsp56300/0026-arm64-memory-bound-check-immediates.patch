 namespace dsp56k
 {
+	// MS2000 MAC-1: the flags for "_offset >= _value". ARM64 cmp only takes a 12-bit immediate (optionally
+	// shifted by 12), so the memory size $1000000 - also the default bridged address - does not encode,
+	// and asmjit drops the instruction. For a power of two the same test is "any bit at or above it set",
+	// an encodable logical immediate; the caller branches/selects on the condition returned.
+#ifdef HAVE_ARM64
+	static asmjit::arm::CondCode cmpGreaterEqual(JitEmitter& _a, const JitRegGP& _offset, const TWord _value)
+	{
+		if(_value >= 0x1000 && (_value & (_value - 1)) == 0)
+		{
+			_a.test_(r32(_offset), asmjit::Imm(~(_value - 1)));
+			return asmjit::arm::CondCode::kNE;
+		}
+		_a.cmp(r32(_offset), asmjit::Imm(_value));
+		return asmjit::arm::CondCode::kGE;
+	}
+#endif
+
+	// "if(_offset >= _size) goto _skip"
+	static void jumpIfOutOfRange(JitEmitter& _a, const JitRegGP& _offset, const TWord _size, const asmjit::Label& _skip)
+	{
+#ifdef HAVE_ARM64
+		_a.b(cmpGreaterEqual(_a, _offset, _size), _skip);
+#else
+		_a.cmp(r32(_offset), asmjit::Imm(_size));
+		_a.jge(_skip);
+#endif
+	}
+
 	void Jitmem::mov(uint32_t* _dst, const uint32_t& _imm) const
 	{
